{
  "name": "oro",
  "version": "1.0.0",
  "description": "Une application vierge avec mise à jour automatique via GitHub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -p always"
  },
  "author": "Romain Llave",
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.romainllave.oro",
    "productName": "Oro",
    "publish": [
      {
        "provider": "github",
        "owner": "romainllave",
        "repo": "Oro"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
